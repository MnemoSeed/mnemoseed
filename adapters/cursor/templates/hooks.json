{
  "description": "MnemoSeed memory hooks — warm up on session start and capture every full assistant response and tool call with provenance",
  "hooks": {
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \".cursor/hooks/mnemoseed/py.sh\" \".cursor/hooks/mnemoseed/session_start.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \".cursor/hooks/mnemoseed/py.sh\" \".cursor/hooks/mnemoseed/post_tool_use.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "afterAgentResponse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \".cursor/hooks/mnemoseed/py.sh\" \".cursor/hooks/mnemoseed/after_agent_response.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
