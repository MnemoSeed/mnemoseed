{
  "description": "MnemoSeed memory hooks — warm up on session start, inject the budgeted recall per user prompt, and settle via the session transcript",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"~/.codex/mnemoseed/py.sh\" \"~/.codex/mnemoseed/session_start.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"~/.codex/mnemoseed/py.sh\" \"~/.codex/mnemoseed/user_prompt_submit.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"~/.codex/mnemoseed/py.sh\" \"~/.codex/mnemoseed/session_end.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
