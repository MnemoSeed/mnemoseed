{
  "name": "mnemoseed",
  "version": "0.1.0",
  "description": "Persistent, provenance-first memory for Gemini CLI — captures every agent turn and tool call through hooks, warms sessions with the latest context, and injects a per-turn recall on every BeforeAgent event",
  "context": ["GEMINI.md"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/py.sh hooks/session_start.py",
            "timeout": 60
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/py.sh hooks/before_agent.py",
            "timeout": 30
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/py.sh hooks/after_tool.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "commands": "./commands",
  "mcpServers": {
    "mnemoseed": {
      "command": "mnemoseed",
      "args": ["mcp"]
    }
  }
}
